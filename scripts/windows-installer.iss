; Generated by scripts/build.ts from package.json and src/dsh.ts.
#include "..\dist\installer-versions.iss"

[Setup]
AppId={{074D4E49-6F97-490B-A4D9-84D4C6D9136C}
AppName=Aegis
AppVersion={#AppVersion}
AppPublisher=ALwith
DefaultDirName={localappdata}\Programs\Aegis
DefaultGroupName=Aegis
PrivilegesRequired=lowest
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
OutputDir=..\dist
OutputBaseFilename=Aegis-{#AppVersion}-windows-x64-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\aegis.exe
DisableProgramGroupPage=yes
InfoAfterFile=..\dist\INSTALL-NOTES.txt

[Files]
Source: "..\dist\aegis-windows-x64.exe"; DestDir: "{app}"; DestName: "aegis.exe"; Flags: ignoreversion
Source: "launch-windows.cmd"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\dist\INSTALL-NOTES.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\dist\runtime\deepseek-harness-sdk-runtime-win-x64.exe"; DestDir: "{%USERPROFILE}\.aegis\dsh\{#RuntimeVersion}"; Flags: ignoreversion uninsneveruninstall
Source: "..\dist\runtime\deepseek-harness-sdk-runtime-win-x64-rg.exe"; DestDir: "{%USERPROFILE}\.aegis\dsh\{#RuntimeVersion}"; Flags: ignoreversion uninsneveruninstall
Source: "..\dist\runtime\.complete"; DestDir: "{%USERPROFILE}\.aegis\dsh\{#RuntimeVersion}"; Flags: ignoreversion uninsneveruninstall

[Icons]
Name: "{group}\Aegis"; Filename: "{app}\launch-windows.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\aegis.exe"
Name: "{group}\Uninstall Aegis"; Filename: "{uninstallexe}"
